<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="@color/card_background"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Service Name -->
        <TextView
            android:id="@+id/servicoNomeText"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Corte Social"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/servicoPrecoText" />

        <!-- Duration -->
        <LinearLayout
            android:id="@+id/duracaoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@id/servicoNomeText"
            app:layout_constraintStart_toStartOf="parent">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_clock"
                app:tint="@color/text_secondary" />

            <TextView
                android:id="@+id/servicoDuracaoText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40 min"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                android:layout_marginStart="6dp" />
        </LinearLayout>

        <!-- Badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/badgeCard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:cardBackgroundColor="#1E3A5F"
            app:cardCornerRadius="6dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            app:layout_constraintTop_toBottomOf="@id/duracaoLayout"
            app:layout_constraintStart_toStartOf="parent">

            <TextView
                android:id="@+id/badgeText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DISPONÍVEL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="#60A5FA"
                android:paddingHorizontal="8dp"
                android:paddingVertical="4dp"
                android:letterSpacing="0.05" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Price -->
        <TextView
            android:id="@+id/servicoPrecoText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="R$ 45,00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#3B82F6"
            android:layout_marginStart="16dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>