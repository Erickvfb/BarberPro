<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Seletor de Produto -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PRODUTO:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#6B7280"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/productSelectorCard"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#F9FAFB"
        app:cardCornerRadius="8dp"
        app:cardElevation="0dp"
        app:strokeColor="#D1D5DB"
        app:strokeWidth="1dp"
        android:clickable="true"
        android:focusable="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/selectedProductText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Selecione um produto do estoque"
                android:textSize="14sp"
                android:textColor="#6B7280" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_arrow_down"
                app:tint="#6B7280" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Quantidade -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="QUANTIDADE:"
        android:textSize="11sp"
        android:textStyle="bold"
        android:textColor="#6B7280"
        android:letterSpacing="0.05"
        android:layout_marginBottom="8dp" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/quantityLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:boxBackgroundMode="outline"
        app:boxStrokeColor="#3B82F6"
        app:boxStrokeWidth="1dp"
        app:hintEnabled="false"
        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/quantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Ex: 1, 2, 3..."
            android:textSize="14sp"
            android:inputType="number"
            android:textColor="#111827"
            android:textColorHint="#9CA3AF"
            android:paddingVertical="14dp" />
    </com.google.android.material.textfield.TextInputLayout>

    <!-- Info do Produto Selecionado -->
    <LinearLayout
        android:id="@+id/productInfoSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"
        android:padding="12dp"
        android:background="#F3F4F6"
        android:layout_marginBottom="8dp">

        <!-- Preço Unitário -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Preço unitário:"
                android:textSize="13sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/unitPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#111827" />
        </LinearLayout>

        <!-- Estoque Disponível -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="4dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Em estoque:"
                android:textSize="13sp"
                android:textColor="#6B7280" />

            <TextView
                android:id="@+id/stockQuantityText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 un"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#059669" />
        </LinearLayout>

        <!-- Divisor -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#E5E7EB"
            android:layout_marginVertical="8dp" />

        <!-- Total -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="TOTAL:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#111827" />

            <TextView
                android:id="@+id/totalPriceText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="R$ 0,00"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#3B82F6" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>